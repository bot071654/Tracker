# Copy this file to .env and fill in your own PostgreSQL details.
# .env is read at startup; credentials are never stored in the code.

POSTGRES_HOST=localhost

# PostgreSQL's usual default is 5432. The PostgreSQL 18 install on this
# machine listens on 5433 - check postgresql.conf if connections fail.
POSTGRES_PORT=5433

POSTGRES_DATABASE=poker_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
