# Copy this file to .env and fill in the details of the PostgreSQL server the
# team has agreed on. .env is gitignored and must never be committed.
#
# Every one of these must be set. There are no defaults: a missing setting is
# an error, not a guess. That is deliberate - the values a guess would use
# (localhost:5432, user "postgres", blank password) are exactly a stock local
# PostgreSQL install, so a missing .env used to mean your hands were recorded
# into a private database nobody else could see, with no warning at all.
#
# See docs/DATABASE.md for which server to point at and how to start it.

# The machine running the PostgreSQL container.
#   localhost        - you are running the container yourself
#   db               - your application also runs inside this compose project
#   10.0.0.42        - the team's shared database host (ask for the address)
# Do not assume localhost is right for you.
POSTGRES_HOST=localhost

# The port published on POSTGRES_HOST. 5433 by default here, so the container
# does not collide with a PostgreSQL already installed on the machine (which
# would be on 5432). Inside the compose network the port is 5432.
POSTGRES_PORT=5433

POSTGRES_DATABASE=poker_tracker

# The application's own role. Not "postgres" - that is the superuser, and this
# application has no reason to be one.
POSTGRES_USER=poker_tracker

# Ask whoever runs the database server. Never commit the real value, and never
# paste it into this file.
POSTGRES_PASSWORD=CHANGE_ME

# Optional. Unset (the default) behaves exactly as before this setting
# existed - no sslmode is sent, which is right for the local Docker container.
# A managed/cloud server usually needs one of: disable, allow, prefer,
# require, verify-ca, verify-full. Leave this unset for local Docker.
# POSTGRES_SSLMODE=require
