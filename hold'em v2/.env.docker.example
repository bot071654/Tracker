# Credentials for the PostgreSQL SERVER, read by docker-compose.yml.
#
# You only need this file on a machine that hosts the database and does NOT
# run the tracker. If the machine has an .env - because it runs the tracker
# too - compose reads that by default and already finds everything it needs:
#
#     docker compose up -d db
#
# On a dedicated database host, copy this to .env.docker (gitignored), fill it
# in, and name it explicitly:
#
#     docker compose --env-file .env.docker up -d db
#
# These values initialise the database the FIRST time the volume is created.
# Changing POSTGRES_PASSWORD here later does NOT change the password of an
# existing database - see docs/DATABASE.md for how to rotate it.

POSTGRES_DATABASE=poker_tracker
POSTGRES_USER=poker_tracker

# Generate a strong one, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Never commit the real value.
POSTGRES_PASSWORD=CHANGE_ME

# Port published on the host.
POSTGRES_PORT=5433

# Which interface the port is published on. This decides who can reach the
# database.
#   127.0.0.1   this machine only (safe default)
#   10.0.0.42   a specific LAN address, for a shared team server
# Never 0.0.0.0 on a machine with a public IP.
DB_BIND=127.0.0.1
